<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tube" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Прозрачная активность ярлыка «YouTube через Tube»: включает обход и сразу открывает клиент. -->
    <style name="Theme.Tube.Launch" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
